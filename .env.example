# Shared
NODE_ENV=development

# API
PORT=3000
APP_NAME=AHub API
HEALTHCHECK_TOKEN=replace-me
TELEGRAM_BOT_TOKEN=dev-telegram-token
TELEGRAM_INIT_DATA_TTL_SEC=300
GML_TIMEOUT_MS=250
GML_RETRY_ATTEMPTS=2
GML_MOCK_MODE=success

# Web
WEB_PORT=3001
WEB_APP_NAME=AHub
API_BASE_URL=http://localhost:3000
WEB_TELEMETRY_URL=http://localhost:3000/client-telemetry
TELEGRAM_BOT_NAME=ahub_bot
WEB_AUTH_MODE=telegram-init-data
